# Agent Connect (MCP) — dashboard → Agent Integrations → API Key (30-day Bearer)
AGENT_CONNECT_KEY=
AGENT_CONNECT_MCP_URL=
AGENT_CONNECT_ACCOUNT=

# Ping staging facilitator (Dashboard → API Keys; Agent Pay enabled on org)
PINGPAY_STAGING_API_KEY=
STAGING_BASE_URL=

# Base mainnet EVM refund address (0x + 40 hex) — payer-chain refund if deposit fails; required for v2 quote verify.
# Often the Agent Connect linked EVM account from MCP get_accounts (not the NEAR account id).
REFUND_ADDRESS=

# Human USDC the merchant should receive (destination NEAR USDC); use >= 0.2 on staging (1Click bridge minimum)
TEST_AMOUNT_USDC=

# Intents source asset for Base delivery (NEAR-chain USDC balance → withdraw chain=base). Default matches live E2E.
NEAR_USDC_WITHDRAW_TOKEN=
